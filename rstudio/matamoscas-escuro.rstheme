/* rs-theme-name: Matamoscas Escuro */
/* rs-theme-is-dark: TRUE */
/* Basado no tema Monokai Pro do RStudio, com a paleta Matamoscas Escuro
   do tema homónimo para Mattermost:
   - Azul:     #009DE0 (acentos, cursor)
   - Escuro:   #242C32 / #28313A / #333D45 (superfícies)
   - Cinzento: #D2D3D4 (texto) */

.ace_gutter {
  background: #28313A;
  color: #5A6871;
}

.ace_print-margin {
  width: 1px;
  background: #2E3940;
}

.ace_editor, .rstudio-themes-flat.ace_editor_theme .profvis-flamegraph, .rstudio-themes-flat.ace_editor_theme, .rstudio-themes-flat .ace_editor_theme {
  background-color: #242C32;
  color: #D2D3D4;
}

.ace_cursor {
  color: #009DE0;
}

.normal-mode .ace_cursor {
  border: 0 !important;
  background-color: rgba(0, 157, 224, 0.6);
}

.ace_marker-layer .ace_selection {
  background: #153F52;
}

.ace_selection.ace_start {
  box-shadow: 0 0 3px 0px #242C32;
  border-radius: 2px;
}

.ace_marker-layer .ace_step {
  background: rgba(0, 157, 224, 0.25);
}

.ace_marker-layer .ace_bracket {
  margin: -1px 0 0 -1px;
  border: 1px solid rgba(0, 157, 224, 0.5);
}

.ace_marker-layer .ace_active-line {
  background: #2A343D;
}

.ace_gutter-active-line {
  background-color: #2A343D;
}

.ace_marker-layer .ace_selected-word {
  border: 1px solid #153F52;
}

.ace_fold {
  background-color: rgba(0, 157, 224, 0.5);
  border-color: #009DE0;
}

.ace_invisible {
  color: rgba(210, 211, 212, 0.3);
}

.ace_keyword {
  color: #C792EA;
}

.ace_keyword.ace_operator {
  color: #88DDFF;
}

.ace_constant.ace_language {
  color: #88DDFF;
}

.ace_constant.ace_numeric {
  color: #F88C6C;
}

.ace_constant.ace_character {
  color: #F88C6C;
}

.ace_constant.ace_other {
  color: #D2D3D4;
}

.ace_support.ace_function {
  color: #8AAAFF;
}

.ace_support.ace_constant {
  color: #F88C6C;
}

.ace_support.ace_class {
  color: #F07178;
}

.ace_support.ace_type {
  color: #F07178;
}

.ace_storage {
  color: #C792EA;
}

.ace_storage.ace_type {
  color: #C792EA;
}

.ace_invalid {
  color: #FFFFFF;
  background-color: #E05252;
}

.ace_invalid.ace_deprecated {
  color: #FFFFFF;
  background-color: #C792EA;
}

.ace_string {
  color: #C3E88D;
}

.ace_comment {
  color: #5DADE2;
}

.ace_variable {
  font-style: italic;
  color: #C792EA;
}

.ace_variable.ace_parameter {
  font-style: italic;
  color: #F88C6C;
}

.ace_entity.ace_other.ace_attribute-name {
  color: #C792EA;
}

.ace_entity.ace_name.ace_function {
  font-style: italic;
  color: #80CBC4;
}

.ace_entity.ace_name.ace_tag {
  color: #F07178;
}

.nocolor.ace_editor .ace_line span {
  color: #C792EA !important;
}

.ace_bracket {
  margin: 0 !important;
  border: 0 !important;
  background-color: rgba(0, 157, 224, 0.4);
}

.ace_marker-layer .ace_foreign_line {
  position: absolute;
  z-index: -1;
  background-color: #28313A;
}

.ace_node-selector {
  background-color: #153F52;
}

.ace_comment-highlight {
  color: #242C32;
  background-color: #2A343D;
}

.ace_marker-layer .ace_active_debug_line {
  position: absolute;
  z-index: -1;
  background-color: #28313A;
}

.ace_marker-layer .ace_find_line {
  position: absolute;
  z-index: -1;
  background-color: #153F52;
}

.ace_console_error {
  background-color: #153F52;
}

/* --- Terminal (escuro, com acento institucional) --- */

.terminal {
  background-color: #242C32;
  color: #D2D3D4;
  font-feature-settings: "liga" 0;
  position: relative;
  user-select: none;
  -ms-user-select: none;
  -webkit-user-select: none;
}

.terminal.xterm-cursor-style-block.focus:not(.xterm-cursor-blink-on) .terminal-cursor {
  background-color: #009DE0;
  color: #242C32;
}

.terminal.focus.xterm-cursor-style-bar:not(.xterm-cursor-blink-on) .terminal-cursor::before,
.terminal.focus.xterm-cursor-style-underline:not(.xterm-cursor-blink-on) .terminal-cursor::before {
  content: '';
  position: absolute;
  background-color: #009DE0;
}

.terminal:not(.focus) .terminal-cursor {
  outline: 1px solid #D2D3D4;
  outline-offset: -1px;
}

.terminal .xterm-selection div {
  position: absolute;
  background-color: #153F52;
}

.terminal .xterm-viewport {
  background-color: #242C32;
  overflow-y: scroll;
}

.xtermInvertColor { color: #242C32; }
.xtermInvertBgColor { background-color: #D2D3D4; }
.xtermBold { font-weight: bold; }
.xtermUnderline { text-decoration: underline; }
.xtermBlink { text-decoration: blink; }
.xtermHidden { visibility: hidden; }
.xtermItalic { font-style: italic; }
.xtermStrike { text-decoration: line-through; }

/* ------------------------------------------------------------------
   INSERIR AQUI, SEM ALTERAÇÕES, o bloco original dos 256 colors
   (desde .xtermColor0 { color: #2e3436 !important; } até
   .xtermBgColor255 { background-color: #eeeeee; }) do ficheiro
   Monokai Pro original.
   São cores ANSI fixas do terminal, sem equivalente no Matamoscas.
   ------------------------------------------------------------------ */

.rstudio-themes-flat.editor_dark.ace_editor_theme a {
  color: #FFF !important;
}

.ace_layer {
  z-index: 4;
}

.ace_layer.ace_print-margin-layer {
  z-index: 2;
}

.ace_layer.ace_marker-layer {
  z-index: 1;
}

.ace_layer.ace_cursor-layer {
  z-index: 3;
}

/* --- Autocompletar --- */

.rstudio-themes-flat.rstudio-themes-dark-menus .ace_editor.ace_autocomplete {
  background: #28313A;
  border: solid 1px #46555F !important;
  color: #D2D3D4;
}

.rstudio-themes-flat.rstudio-themes-dark-menus .ace_editor.ace_autocomplete .ace_marker-layer .ace_active-line,
.rstudio-themes-flat.rstudio-themes-dark-menus .ace_editor.ace_autocomplete .ace_marker-layer .ace_line-hover {
  background: rgba(0, 157, 224, 0.25);
  border: none;
}
