/* rs-theme-name: Matamoscas Claro */
/* rs-theme-is-dark: FALSE */

/* ============================================================
   Matamoscas Claro para RStudio
   Tema baseado na paleta institucional DPQ:
   - Azul:    #009DE0 (acentos)
   - Ardósia: #46555F (barra lateral, superfícies)
   - Cinzento: #D2D3D4 (texto secundário)
   ============================================================ */

/* --- Gutter (número de linhas) --- */
.ace_gutter {
  background: #E8EBED;
  color: #5A676E;
}

.ace_print-margin {
  width: 2px;
  background: #DDE2E5;
}

/* --- Editor principal (claro) --- */
.ace_editor {
  background-color: #F7F8F8;
  color: #2E3940;
}

.rstudio-themes-flat.ace_editor_theme {
  background-color: #F7F8F8;
  color: #2E3940;
}

.rstudio-themes-flat.ace_editor_theme .profvis-flamegraph {
  background-color: #F7F8F8;
  color: #2E3940;
}

.rstudio-themes-flat .ace_editor_theme {
  background-color: #F7F8F8;
  color: #2E3940;
}

.rstudio-themes-flat.editor_light.ace_editor_theme a {
  color: #0084BF !important;
}

.rstudio-themes-flat .gwt-Label {
  color: #2E3940;
}

/* --- Cursor e seleção --- */
.ace_cursor {
  color: #009DE0;
}

.normal-mode .ace_cursor {
  border: 0 !important;
  background-color: #009DE0;
}

.ace_marker-layer .ace_selection {
  background: #DFF4FC;
}

.ace_marker-layer .ace_step {
  background: #d9f1b7;
}

.ace_marker-layer .ace_bracket {
  margin: -1px 0 0 -1px;
  border: 1px solid rgba(0, 157, 224, 0.4);
}

.ace_marker-layer .ace_active-line {
  background: #EEF2F3;
}

.ace_marker-layer .ace_selected-word {
  border: 1px solid #DFF4FC;
}

.ace_marker-layer .ace_foreign-line {
  position: absolute;
  z-index: -1;
  background-color: #EEF2F3;
}

.ace_marker-layer .ace_active_debug_line {
  position: absolute;
  z-index: -1;
  background-color: #E8EBED;
}

.ace_marker-layer .ace_find_line {
  position: absolute;
  z-index: -1;
  background-color: #DFF4FC;
}

.ace_gutter-active-line {
  background-color: #F7F8F8;
}

.ace_fold {
  background-color: rgba(0, 157, 224, 0.5);
  border: 1px solid #009DE0 !important;
}

.ace_indent-guide {
  border-right: 1px solid rgba(100, 110, 120, 0.3);
  margin-right: -1px;
}

.ace_active-line ~ .ace_selection.ace_start {
  background-color: #E8EBED;
}

/* --- Syntax highlighting (cores ajustadas para fundo claro) --- */
.ace_keyword {
  font-style: normal;
  color: #8B5CF6;
}

.ace_keyword.ace_operator {
  font-style: normal;
  color: #0084BF;
}

.ace_keyword.ace_other.ace_unit {
  font-style: normal;
  color: #D97706;
}

.ace_constant.ace_language {
  color: #0084BF;
}

.ace_constant.ace_numeric {
  color: #D97706;
}

.ace_constant.ace_character {
  color: #D97706;
}

.ace_constant.ace_other {
  color: #2E3940;
}

.ace_support.ace_function {
  color: #2563EB;
}

.ace_support.ace_constant {
  color: #D97706;
}

.ace_support.ace_class {
  font-style: italic;
  color: #DC2626;
}

.ace_support.ace_type {
  color: #DC2626;
}

.ace_paren.ace_keyword.ace_operator {
  color: #0084BF;
}

.ace_storage {
  color: #8B5CF6;
}

.ace_storage.ace_type {
  color: #8B5CF6;
}

.ace_invalid {
  background-color: rgba(0, 157, 224, 0.5);
}

.ace_invalid.ace_deprecated {
  background-color: rgba(139, 92, 246, 0.5);
}

.ace_string {
  color: #059669;
}

.ace_comment {
  font-style: italic;
  color: #6B7280;
}

.ace_invisible {
  color: rgba(100, 110, 120, 0.3);
}

.ace_variable {
  color: #8B5CF6;
}

.ace_variable.ace_parameter {
  color: #D97706;
}

.ace_identifier {
  color: #2E3940;
  background-color: inherit;
}

.ace_entity.ace_name.ace_function {
  color: #059669;
}

.ace_entity.ace_name.ace_tag {
  color: #DC2626;
}

.ace_entity.ace_other.ace_attribute-name {
  color: #8B5CF6;
}

.ace_bracket {
  margin: 0 !important;
  border: 0 !important;
  background-color: rgba(0, 157, 224, 0.4);
}

.ace_console_error {
  background-color: #FEE2E2;
  color: #DC2626;
}

.ace_layer {
  z-index: 4;
}

.ace_layer.ace_print-margin-layer {
  z-index: 2;
}

.ace_layer.ace_marker-layer {
  z-index: 1;
}

.ace_layer.ace_cursor-layer {
  z-index: 3;
}

.ace_selection.ace_start {
  box-shadow: 0 0 3px 0 #F7F8F8;
  border-radius: 2px;
}

.ace_meta.ace_tag {
  color: #DC2626;
}

.ace_markup.ace_heading,
.ace_markup.ace_heading ~ .ace_heading {
  font-weight: normal;
  color: #D97706;
}

.ace_support.ace_function.ace_codebegin, .ace_support.ace_function.ace_codeend {
  color: #8B5CF6;
}

.ace_markup.ace_href {
  color: #059669;
}

.nocolor.ace_editor .ace_line span {
  color: #8B5CF6 !important;
}

#rstudio_console_input .ace_marker-layer .ace_selection {
  background: #DFF4FC;
}

/* ============================================================
   INTERFACE RSTUDIO (claro)
   ============================================================ */

/* background */
.rstudio-themes-flat .rstudio-themes-light-grey {
  background: #46555F !important;
  color: #FFFFFF !important;
}

.rstudio-themes-flat .rstudio-themes-light-grey .rstudio-themes-background {
  background: #46555F !important;
}

.rstudio-themes-flat .rstudio-themes-light-grey [role="banner"] + [role="navigation"] > table > tbody > tr > td,
.rstudio-themes-flat .rstudio-themes-light-grey header + [role="navigation"] > table > tbody > tr > td {
  background: #46555F;
  border-color: #F7F8F8;
}

.rstudio-themes-flat .rstudio-themes-light-grey .rstudio-themes-border {
  border-color: #F7F8F8;
}

/* inactive tabs */
table.rstheme_tabLayoutCenter,
.rstudio-themes-flat .rstudio-themes-light-grey .gwt-TabLayoutPanelTabs,
.rstheme_multiPodUtilityTabArea {
  background: #46555F !important;
}

table.rstheme_tabLayoutCenter .gwt-Label,
.rstudio-themes-flat .rstudio-themes-light-grey .gwt-TabLayoutPanelTabs .gwt-Label,
.rstheme_multiPodUtilityTabArea .gwt-Label {
  color: #FFFFFF;
}

/* toolbar and selected tab */
.rstudio-themes-flat .rstudio-themes-light-grey .rstheme_center,
.rstudio-themes-flat .rstudio-themes-light-grey .gwt-TabLayoutPanelTabs .gwt-TabLayoutPanelTab-selected table.rstheme_tabLayoutCenter {
  background: #46555F !important;
}

.rstudio-themes-flat .rstudio-themes-light-grey .gwt-TabLayoutPanelTab-selected .gwt-Label {
  color: #FFFFFF;
}

.rstudio-themes-flat .rstudio-themes-light-grey .gwt-TabLayoutPanelTab:hover .rstheme_tabLayoutCenter {
  background: #55656F !important;
}

.rstudio-themes-flat .rstheme_toolbarWrapper {
  background: #46555F !important;
}

.rstudio-themes-flat .rstheme_toolbarWrapper button, .rstudio-themes-flat .rstheme_toolbarWrapper a, .rstudio-themes-flat .rstheme_toolbarWrapper div {
  color: #D2D3D4 !important;
}

.rstudio-themes-flat.editor_light .ace_editor_theme .GCHYANPCGI {
    color: #2E3940;
}

.rstudio-themes-flat .rstudio-themes-light-grey .gwt-SplitLayoutPanel-HDragger, .rstudio-themes-flat .rstudio-themes-light-grey .gwt-SplitLayoutPanel-VDragger {
  background: transparent !important;
}

.rstudio-themes-flat .rstudio-themes-light .search, .rstudio-themes-flat.rstudio-themes-light-menus .search {
  background: #46555F !important;
}

.rstudio-themes-flat #rstudio_workbench_panel_find_in_files td[colspan="2"] {
  color: #009DE0;
}

/* pane toolbars */
.rstheme_secondaryToolbar, .rstudio-themes-flat .rstudio-themes-light-grey .dataGridHeader {
  background: #46555F !important;
}

/* menu background */
.rstudio-themes-flat .popupMiddleCenter,
.rstudio-themes-flat .menuPopupMiddleCenter,
.rstudio-themes-flat .suggestPopupMiddleCenter {
  background: #FFFFFF !important;
  color: #2E3940 !important;
}

.rstudio-themes-flat .popupMiddleCenter .item.item-selected,
.rstudio-themes-flat .menuPopupMiddleCenter .item.item-selected,
.rstudio-themes-flat .suggestPopupMiddleCenter .item.item-selected {
  color: #FFFFFF !important;
  background: #46555F !important;
}

.rstudio-themes-flat .themedPopupPanel {
  border: solid 1px #46555F;
}

.rstudio-themes-flat .themedPopupPanel ~ div.popupContent div:nth-child(1) {
  border: solid 1px #46555F;
}

.rstudio-themes-flat .popupContent {
  background: #FFFFFF;
  color: #2E3940;
  border-color: #46555F;
}

.rstudio-themes-flat .popupContent:not(.popupMiddleCenterInner) div div:nth-child(2) {
  background-color: unset;
  border: none;
}

.rstudio-themes-flat .popupContent + .rstudio-themes-scrollbars {
  border-color: #46555F;
}

.rstudio-themes-flat .gwt-PopupPanel .popupContent {
  background: #FFFFFF;
  padding: 2px;
}

.rstudio-themes-flat .gwt-PopupPanel .popupContent table {
  background: #FFFFFF;
  border: 0;
}

.rstudio-themes-flat .gwt-PopupPanel .popupContent table .gwt-Label {
  color: #2E3940;
}

.rstudio-themes-flat.rstudio-themes-light-menus .gwt-MenuItem.gwt-MenuItem-selected, .rstudio-themes-flat.rstudio-themes-light-menus .gwt-MenuItem.gwt-MenuItem-selected > table {
  background: #46555F;
  color: #FFFFFF;
}

/* datagrid */
.rstudio-themes-light .dataGridHeader,
.rstudio-themes-light tr[__gwt_header_row] > :-webkit-any(td, th),
.rstudio-themes-light .dataTables_info {
  background-color: #FFFFFF !important;
  border-color: #E8EBED !important;
}

/* Data Frame Preview */
.dataTables_wrapper thead th {
  background-color: #F7F8F8 !important;
  color: #2E3940 !important;
}

.dataTables_scrollBody table tbody td:first-child {
  background: #F7F8F8 !important;
  color: #2E3940 !important;
}

.dataTables_info {
  background: #F7F8F8 !important;
  color: #2E3940 !important;
}

.rstudio-themes-flat.rstudio-themes-light-grey #rsGridData_info, .rstudio-themes-flat.rstudio-themes-light-grey table.dataTable thead th, .rstudio-themes-flat.rstudio-themes-light-grey table.dataTable thead td, .rstudio-themes-flat.rstudio-themes-light-grey table.dataTable tbody td {
    border-color: #E8EBED;
}

/* scrollbars */
.rstudio-themes-flat {
  scrollbar-width: auto;
  scrollbar-color: #46555F #FFFFFF;
}

.rstudio-themes-flat ::-webkit-scrollbar {
  width: auto;
}

.rstudio-themes-flat *::-webkit-scrollbar-track {
  background: #FFFFFF;
}

.rstudio-themes-flat *::-webkit-scrollbar-thumb {
  background-color: #46555F;
  border-radius: 0px;
  border: 2px solid #FFFFFF;
}

.rstudio-themes-flat *::-webkit-scrollbar-thumb:hover {
  background-color: #55656F;
}

/* job progress bar */
.rstheme_toolbarWrapper [role="progressbar"] > div, .windowframe [role="progressbar"] > div {
  background-color: #009DE0;
}

/* borders on toolbar under editor */
.rstudio-themes-flat .rstudio-themes-light table.rstudio-themes-background td > div:first-child {
  border-color: #46555F !important;
}

/* splitters */
.rstudio-themes-flat > .rstudio-themes-light .gwt-SplitLayoutPanel-HDragger {
  border-color: #46555F;
}

.rstudio-themes-flat > .rstudio-themes-light .gwt-SplitLayoutPanel-VDragger {
  border-color: #46555F;
}

.rstudio-themes-flat > .rstudio-themes-light .gwt-SplitLayoutPanel td {
  border-color: #F7F8F8 !important;
}

/* window containers */
.rstudio-themes-flat
> .rstudio-themes-light
:-webkit-any(.windowframe, .rstheme_minimizedWindowObject)
> div:last-child {
  border-radius: 0;
  border-color: #F7F8F8;
}

/* main toolbar */
.rstudio-themes-light > div:last-child > div > div > .rstheme_toolbarWrapper,
.rstudio-themes-light [role="application"] > div > .rstheme_toolbarWrapper {
  border-color: #46555F;
}

/* toolbars */
.rstudio-themes-light .rstheme_toolbarWrapper,
.rstudio-themes-light .rstheme_secondaryToolbar {
  border-color: #46555F !important;
  border-radius: 0 !important;
}

/* other toolbars */
.rstudio-themes-light .rstudio-themes-background {
  border-top-color: #46555F !important;
  border-bottom-color: #46555F !important;
  border-radius: 0 !important;
}

/* tabs container */
.rstudio-themes-light .gwt-TabLayoutPanelTabs,
.rstudio-themes-light .windowframe,
.rstudio-themes-light :-webkit-any(.rstheme_multiPodUtilityTabArea, .GD15MCFCCS, .GJQ3LUQCCS) {
  background: #46555F !important;
  border-color: #46555F !important;
}

/* tabs */
.rstudio-themes-light .gwt-TabLayoutPanelTab:not(.gwt-TabLayoutPanelTab-selected) .rstheme_tabLayoutCenter,
.rstudio-themes-light .rstheme_minimizedWindowObject .rstheme_center {
  border-color: #46555F !important;
  border-right: 1px solid #46555F !important;
  border-radius: 0;
}

/* active tab */
.rstudio-themes-light .gwt-TabLayoutPanelTab.gwt-TabLayoutPanelTab-selected .rstheme_tabLayoutCenter {
  border: none;
}

/* ============================================================
   TERMINAL (mantém-se escuro)
   ============================================================ */

.terminal {
  background-color: #242C32;
  color: #D2D3D4;
  font-feature-settings: "liga" 0;
  position: relative;
  user-select: none;
  -ms-user-select: none;
  -webkit-user-select: none;
}

.terminal.xterm-cursor-style-block.focus:not(.xterm-cursor-blink-on) .terminal-cursor {
  background-color: #009DE0;
  color: #009DE0;
}

.terminal.focus.xterm-cursor-style-bar:not(.xterm-cursor-blink-on) .terminal-cursor::before, .terminal.focus.xterm-cursor-style-underline:not(.xterm-cursor-blink-on) .terminal-cursor::before {
  content: '';
  position: absolute;
  background-color: #242C32;
}

.terminal:not(.focus) .terminal-cursor {
  outline: 1px solid #D2D3D4;
  outline-offset: -1px;
}

.terminal .xterm-selection {
  opacity: 1 !important;
  z-index: 0 !important;
}

.terminal .xterm-selection div {
  position: absolute;
  background-color: #153F52;
}

.terminal .xterm-viewport {
  background-color: #242C32;
  overflow-y: scroll;
}

.xtermInvertColor {
  color: #D2D3D4;
}

.xtermInvertBgColor {
  background-color: #242C32;
}

/* ============================================================
   ANSI COLORS (256 colours fixes - manter sem alterações)
   -----------------------------------------------------------
   NOTA: Insira aqui o bloco original dos 256 cores xterm
   (desde .xtermColor0 { color: #2e3436 !important; } até 
   .xtermBgColor255 { background-color: #eeeeee; })
   ============================================================ */

/* --- Rainbow Parenthesis (adjusté para contraste no claro) --- */
.rstudio-themes-light .ace_paren_color_0 {
  color: #0084BF;
}

.rstudio-themes-light .ace_paren_color_1 {
  color: #D97706;
}

.rstudio-themes-light .ace_paren_color_2 {
  color: #DC2626;
}

.rstudio-themes-light .ace_paren_color_3 {
  color: #8B5CF6;
}

.rstudio-themes-light .ace_paren_color_4 {
  color: #059669;
}

.rstudio-themes-light .ace_paren_color_5 {
  color: #EA580C;
}

.rstudio-themes-light .ace_paren_color_6 {
  color: #059669;
}

/* --- Tabs active (clara) --- */
.rstudio-themes-flat .gwt-TabLayoutPanelTab-selected .gwt-TabLayoutPanelTabInner .rstheme_tabLayoutCenter {
  box-shadow: 0 -2.5px 0 #009DE0 inset;
  border-radius: 0 !important;
}

.rstudio-themes-light .dataGridHeader, .rstudio-themes-light tr[__gwt_header_row] > :-webkit-any(td, th), .rstudio-themes-light .dataTables_info {
  background-color: #FFFFFF !important;
  border-color: #46555F !important;
}

/* --- Command Palette --- */
#rstudio_command_palette_search,
#rstudio_command_palette_list [id^="rstudio_command_"],
input#rstudio_command_palette_search {
  background-color: #FFFFFF;
  border: none;
}

#rstudio_command_palette_list {
  background-color: #FFFFFF;
  border-color: #F7F8F8;
}

.rstudio-themes-flat .rstudio-themes-border {
  border-color: #F7F8F8;
}

.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [id*="rstudio_command_"] table .gwt-Label,
.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [id*="rstudio_command_"] table td {
  background-color: #FFFFFF;
  color: #2E3940;
}

.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [id*="rstudio_command_"]:hover, .rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [id*="rstudio_command_"]:hover [id^="rstudio_command_entry"], .rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [id*="rstudio_command_"]:hover table .gwt-Label, .rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [id*="rstudio_command_"]:hover table td {
  background-color: #E8EBED;
}

.rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [aria-selected="true"], .rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [aria-selected="true"] [id^="rstudio_command_entry"], .rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [aria-selected="true"] table .gwt-Label, .rstudio-themes-flat .gwt-PopupPanel .popupContent #rstudio_command_palette_list [aria-selected="true"] table td {
  background-color: #46555F;
  color: #FFFFFF;
}

input#rstudio_command_palette_search {
  padding: 10px 0;
  width: 580px;
  border: none;
}

.js-focus-visible input#rstudio_command_palette_search {
  outline-offset: 5px !important;
}

.rstudio-themes-flat .popupContent [id^="rstudio_command"] [id^="rstudio_command_entry_"] .gwt-Label, .rstudio-themes-flat .popupContent [id^="rstudio_command"] [id^="rstudio_command_entry_"] .gwt-Label span {
  border: none;
}

.rstudio-themes-flat > :not(.gwt-DialogBox-ModalDialog) .gwt-TabLayoutPanel > div[aria-hidden="true"] + div {
  height: 40px !important;
  background: #46555F;
}

.rstudio-themes-flat > :not(.gwt-DialogBox-ModalDialog) .gwt-TabLayoutPanel .gwt-TabLayoutPanelTabs table.rstheme_tabLayoutCenter {
  padding-left: 20px;
  padding-right: 20px;
  height: 40px;
}

.rstudio-themes-flat > :not(.gwt-DialogBox-ModalDialog) .gwt-TabLayoutPanel .gwt-TabLayoutPanelTabs .rstheme_tabLayoutCenter td {
  vertical-align: middle !important;
}

.rstudio-themes-flat > :not(.gwt-DialogBox-ModalDialog) .gwt-TabLayoutPanel .gwt-TabLayoutPanelTabs > div:empty {
  height: 40px !important;
}

.rstudio-themes-flat .gwt-TabLayoutPanel .gwt-TabLayoutPanelTabs {
  border-color: #46555F !important;
}

.rstudio-themes-flat .gwt-TabLayoutPanelTabs .gwt-TabLayoutPanelTabInner table.rstheme_tabLayoutCenter tbody > tr > td:last-child > img {
  display: none;
}

.rstudio-themes-flat .gwt-TabLayoutPanelTabs .gwt-TabLayoutPanelTabInner table.rstheme_tabLayoutCenter:hover tbody > tr > td:last-child > img {
  display: inline-block;
  position: absolute !important;
  top: 0 !important;
  padding-left: 3px;
}

.rstudio-themes-flat .gwt-TabLayoutPanelTabs [id^="rstudio_workbench_"] .gwt-TabLayoutPanelTabInner table.rstheme_tabLayoutCenter:hover tbody > tr > td:last-child > img {
  padding-top: 5px;
}

.rstudio-themes-flat .windowframe .gwt-TabLayoutPanel > div:last-child,
.rstudio-themes-flat .gwt-TabLayoutPanel.rstudio_source_panel > div:last-child {
  top: 38px !important;
}

.windowframe > div:last-child > div > div > div[aria-hidden="true"] + div + div {
  height: 40px !important;
}

/* --- Diálogos e formulários --- */
.rstudio-themes-flat [id^="rstudio_dialog"],
.rstudio-themes-flat :not(.gwt-MenuItem-selected):not(.gwt-MenuItem) > [id^="rstudio_label"],
.rstudio-themes-flat .dialogContent [id^="rstudio_label_"][id$="_panel"] :not(button) > table > tbody > td,
.rstudio-themes-flat .dialogTopCenter,
.rstudio-themes-flat .dialogTop,
.rstudio-themes-flat .dialogMiddle,
.rstudio-themes-flat .dataGridHeader {
  background: #F7F8F8 !important;
  color: #2E3940 !important;
}

.rstudio-themes-flat .dialogContent > table:first-child:last-child :not(button) > table, .rstudio-themes-flat .dialogContent > table:first-child:last-child :not(button) > table > tbody > td {
  background: #FFFFFF !important;
  color: #2E3940 !important;
  border-color: #E8EBED !important;
}

.rstudio-themes-flat .dialogContent label.gwt-Label {
  color: #2E3940 !important;
}

.rstudio-themes-flat .dialogContent .gwt-TabLayoutPanelContent .gwt-Label:not(label) {
  color: #009DE0 !important;
}

.rstudio-themes-flat [id^="rstudio_dialog"],
.rstudio-themes-flat .dialogTop .dialogTopCenter,
.rstudio-themes-flat .gwt-DialogBox-ModalDialog,
.rstudio-themes-flat .dataGridHeader {
  border-color: #46555F !important;
}

.rstudio-themes-flat .dialogContent > table div,
.rstudio-themes-flat .dialogContent [id^="rstudio_label_"][id$="_panel"] table tbody td {
  border-color: #46555F;
}

.rstudio-themes-flat .dialogContent .gwt-TabLayoutPanelTab {
  border-color: #46555F !important;
}

.rstudio-themes-flat [id^="rstudio_label"][aria-selected="true"] div,
.rstudio-themes-flat .dialogContent .gwt-TabLayoutPanelTab-selected div {
  background-color: transparent !important;
}

.rstudio-themes-flat .dialogContent .gwt-Button-DialogAction table,
.rstudio-themes-flat .dialogContent .gwt-Button-DialogAction table td,
.rstudio-themes-flat .dialogContent button table,
.rstudio-themes-flat .dialogContent button:not(:hover) table > tbody > tr > td > div {
  background: #F7F8F8 !important;
  color: #2E3940 !important;
  border: 2px solid #46555F !important;
  box-shadow: none !important;
}

.rstudio-themes-flat .gwt-DialogBox .dialogContent [role="listbox"] > div,
.rstudio-themes-flat .gwt-DialogBox .dialogContent [role="listbox"] [role="option"],
.rstudio-themes-flat .gwt-DialogBox .dialogContent [role="listbox"] [role="option"] .gwt-Label,
.rstudio-themes-flat .gwt-DialogBox .dialogContent [role="tablist"],
.rstudio-themes-flat .gwt-DialogBox .dialogContent [role="tablist"] [role="tab"]:not([aria-selected="true"]) .gwt-Label,
.rstudio-themes-flat .gwt-DialogBox .dialogContent .gwt-TabLayoutPanelTab {
  background: #FFFFFF !important;
  color: #2E3940 !important;
}

.rstudio-themes-flat .gwt-DialogBox .dialogContent [id^="rstudio_label"][aria-selected="true"],
.rstudio-themes-flat .gwt-DialogBox .dialogContent [id^="rstudio_label"][aria-selected="true"] td,
.rstudio-themes-flat .gwt-DialogBox .dialogContent .gwt-TabLayoutPanelTab-selected {
  background-color: #46555F !important;
  border-color: #46555F !important;
  color: #FFFFFF !important;
}

.rstudio-themes-flat .gwt-DialogBox .dialogContent .gwt-TabLayoutPanelTab-selected .gwt-Label {
  color: #FFFFFF !important;
}

.rstudio-themes-flat .gwt-DialogBox .dialogContent [id^="rstudio_label"][aria-selected="true"] td .gwt-Label {
  color: #FFFFFF !important;
}

.rstudio-themes-flat .dialogContent button {
  border-width: 2px !important;
  border-style: solid !important;
  border-color: #46555F !important;
  border-radius: 3px !important;
}

.rstudio-themes-flat .dialogContent .gwt-Button-DialogAction:hover table,
.rstudio-themes-flat .dialogContent .gwt-Button-DialogAction:hover table div,
.rstudio-themes-flat .dialogContent button:hover,
.rstudio-themes-flat .dialogContent button:hover table,
.rstudio-themes-flat .dialogContent .gwt-Button:hover > table > tbody > tr > td,
.rstudio-themes-flat .dialogContent button:hover table > tbody > tr > td > div {
  color: #FFFFFF !important;
  background: #55656F !important;
  border-color: #46555F !important;
}

.rstudio-themes-flat .dialogContent input {
  background: #FFFFFF !important;
  color: #2E3940 !important;
  border-color: #46555F !important;
}

.rstudio-themes-flat .dialogContent input[type="checkbox"] {
  background: #46555F !important;
  color: #FFFFFF !important;
}

.rstudio-themes-flat .dialogContent input[type="checkbox"]:checked::before {
  content: "\2713" !important;
  color: #FFFFFF !important;
  vertical-align: top;
  line-height: 1;
  font-weight: 600;
}

.rstudio-themes-flat .dialogContent select {
  background: #46555F !important;
  color: #FFFFFF !important;
}

.rstudio-themes-flat .rstudio-HyperlinkLabel {
  color: #009DE0;
}

.rstudio-themes-flat .search {
  background-color: #46555F;
  color: #FFFFFF;
}

.rstudio-themes-flat .search .rstheme_center img {
  display: none;
}

.rstudio-themes-flat .search .rstheme_center::before {
  content: '\27a0';
  color: #FFFFFF;
}

.rstudio-themes-flat .search .rstheme_center > button::before {
  content: '\2297';
  color: #FFFFFF;
  position: relative;
  top: -3px;
  font-size: 1.25em;
}

.rstudio-themes-flat .search .rstheme_center > button:hover {
  background: unset !important;
  border: unset !important;
}

/* --- Layout de painéis --- */
.GCHYANPCKRB td.GCHYANPCKRB {
    background-color: #46555F;
    vertical-align: top;
    padding: 0;
    border: 0.5px solid #555;
    -moz-border-radius: 6px;
    -webkit-border-radius: 6px;
    border-radius: 6px;
}

.rstudio-themes-flat.editor_light h1, .rstudio-themes-flat.editor_light h2, .rstudio-themes-flat.editor_light h3, .rstudio-themes-flat.editor_light h4 {
    color: #2E3940 !important;
    background: none !important;
    border-color: #D2D3D4 !important;
}

/* --- Switch projects window --- */
.GCHYANPCMUB {
    width: 400px;
    height: 170px;
    border: 1px solid #46555F;
    background-color: #46555F;
}

.GCHYANPCBTB, .GCHYANPCITB, .GCHYANPCDUB, .GCHYANPCLTB {
    background: #46555F;
}

.GCHYANPCCTB, .GCHYANPCJTB, .GCHYANPCEUB, .GCHYANPCMTB, .GCHYANPCKTB {
    border: 2px solid #46555F;
}

.GCHYANPCLUB {
    color: #FFFFFF;
    font-size: 0.9em;
    word-wrap: break-word;
}

/* Import Excel data import options */
.GCHYANPCNTD {
    border: 1px solid #46555F;
    background-color: #46555F;
    padding-top: 12px;
    padding-left: 16px;
    padding-bottom: 3px;
    padding-right: 6px;
    display: -ms-flexbox;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    -ms-flex-direction: column;
    flex-direction: column;
    -ms-flex-grow: 1;
    -webkit-flex-grow: 1;
    flex-grow: 1;
    margin-top: 3px;
    margin-right: 5px;
    margin-left: 5px;
}

.gwt-DialogBox .dialogMiddleCenter, .GCHYANPCOR .popupMiddleCenter {
    background: #46555F;
}

.GCHYANPCCQD {
    width: calc(100% - 10px);
    height: 110px;
    border: 1px solid #46555F;
    background-color: #46555F;
    margin-top: 5px;
    margin-right: 5px;
    margin-left: 5px;
}

/* Import text data import options */
.GCHYANPCASD {
    display: -ms-flexbox;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    -ms-flex-direction: row;
    flex-direction: row;
    -ms-flex-grow: 1;
    -webkit-flex-grow: 1;
    flex-grow: 1;
    border: 1px solid #46555F;
    background-color: #46555F;
    padding-top: 10px;
    padding-left: 10px;
    padding-bottom: 3px;
    margin-top: 3px;
    margin-right: 5px;
    margin-left: 5px;
}

/* Import statistical data import options */
.GCHYANPCPSD {
    border: 1px solid #46555F;
    background-color: #46555F;
    padding-top: 12px;
    padding-left: 16px;
    padding-bottom: 3px;
    padding-right: 6px;
    display: -ms-flexbox;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    -ms-flex-direction: column;
    flex-direction: column;
    -ms-flex-grow: 1;
    -webkit-flex-grow: 1;
    flex-grow: 1;
    margin-top: 3px;
    margin-right: 5px;
    margin-left: 5px;
}
